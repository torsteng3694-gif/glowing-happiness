{
  "name": "ai-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:webpack": "next dev -H 0.0.0.0 -p 3000",
    "dev:turbo": "next dev --turbopack -H 0.0.0.0 -p 3000",
    "dev:reset": "powershell -NoProfile -Command \"if (Test-Path .next) { Remove-Item -Recurse -Force .next }; next dev -H 0.0.0.0 -p 3000\"",
    "dev:local": "next dev -H 127.0.0.1 -p 3000",
    "build": "prisma generate && next build",
    "build:deploy": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "highlight.js": "^11.11.1",
    "jose": "^5.9.6",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

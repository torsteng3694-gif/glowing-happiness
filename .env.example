# 数据库（生产强制 PostgreSQL）
# 本地开发示例： postgresql://postgres:postgres@127.0.0.1:5432/ai_hub?schema=public
# 云上示例：     postgresql://USER:PASS@HOST:5432/ai_hub?schema=public&sslmode=require&connection_limit=10
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ai_hub?schema=public"

# JWT 密钥（务必替换成随机字符串，建议 openssl rand -base64 48）
JWT_SECRET="change-me-to-a-long-random-secret-string"

# 应用版本号（构建时由 CI 注入，/api/health 会回显）
APP_VERSION=""

# 是否使用 mock 调用（true = 不调真实模型，直接返回假数据）
MOCK_PROVIDERS="true"

# 各渠道真实 API Key（填了对应模型会走真实调用）
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"

GOOGLE_API_KEY=""
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# 图片/视频渠道（示例：Replicate / Runway / Luma 可自行扩展）
REPLICATE_API_TOKEN=""
RUNWAY_API_KEY=""

# 管理员邮箱（注册后会自动标记为 admin）
ADMIN_EMAIL="admin@ai-hub.local"

# ========== 星爷ai（/xingye 独立对话页面） ==========
# OpenAI 兼容接口，例如 base_url 末尾带 /v1
XINGYE_BASE_URL="https://api.xingyeai.com/v1"
XINGYE_API_KEY=""
XINGYE_MODEL="gpt-5.4"

# ========== 图生图 / 图生视频 · 参考图上传 ==========
# 很多上游（gpt-image-2、nano-banana-pro、grok-video-3 等）只接受公网 http(s):// URL，
# 不接受 base64 data URL。以下方案二选一（推荐方案 A）：
#
#  方案 A · 腾讯云 COS（强烈推荐 ⭐）
#  -----------------------------------------
#  4 个变量配齐后，public-upload 自动启用 COS（无需再设 PUBLIC_IMAGE_HOST）。
#  生成的关键帧 / 视频片段也会自动转存到 COS，避免上游临时 URL 过期。
#
#  申请步骤：
#    1) 控制台 https://console.cloud.tencent.com/cos/bucket 新建桶
#       - 地域：建议 ap-nanjing 或 ap-beijing
#       - 访问权限：⚠️ 公有读私有写（必选，上游要拉 URL）
#    2) https://console.cloud.tencent.com/cam 创建子用户
#       - 只勾"编程访问"，不要勾控制台
#       - 关联策略：QcloudCOSDataFullControl
#       - 复制 SecretId / SecretKey（只显示一次！）
TENCENT_COS_SECRET_ID=""
TENCENT_COS_SECRET_KEY=""
TENCENT_COS_BUCKET=""        # 含 APPID 后缀，如 ai-hub-1335106858
TENCENT_COS_REGION=""        # 如 ap-nanjing / ap-beijing
TENCENT_COS_PUBLIC_HOST=""   # 可选：自定义 CDN 域名，留空则用默认 myqcloud.com 域名
#
#  方案 B · 公共图床兜底（不推荐生产）
#  -----------------------------------------
#  PUBLIC_IMAGE_HOST="auto"       # 按顺序尝试 cos → telegraph → smms
#  PUBLIC_IMAGE_HOST="telegraph"  # 只用 telegra.ph（国内不稳）
#  PUBLIC_IMAGE_HOST="smms"       # 只用 sm.ms（国内友好，建议配 SMMS_TOKEN）
#  SMMS_TOKEN=""
PUBLIC_IMAGE_HOST=""
SMMS_TOKEN=""

# 自定义公网入口（如果你有自建 ngrok / cloudflared 隧道，且不打算用 COS）
PUBLIC_BASE_URL=""
